* { box-sizing: border-box; }
html, body { width: 100%; height: 100%; margin: 0; padding: 0; overflow: hidden; }
body { background: #222 url('../img/FondoCalidoCafe.jpg') center/cover no-repeat fixed; font-family: sans-serif; }

#screensaver { position: fixed; inset: 0; z-index: 1000; background: #000; transition: opacity 0.4s ease; pointer-events: auto; }
#screensaver.hidden { opacity: 0; pointer-events: none; }
#video-screensaver { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }

.btn-oro { background-image: url('../img/hojaOro.jpg'); background-size: cover; border: 3px solid #b8860b; border-radius: 30px; color: #4a3728; font-weight: 900; font-size: 2.2rem; text-transform: uppercase; text-shadow: 0 1px 0 rgba(255,255,255,0.4); box-shadow: inset 1px 1px 1px rgba(255,255,255,0.6), 0 6px 0 #7d5a0a; display: flex; justify-content: center; align-items: center; cursor: pointer; height: 140px; width: 320px; transition: transform 0.1s; margin: 0 15px; }
.btn-oro:active { transform: translateY(4px); box-shadow: inset 2px 2px 5px rgba(0,0,0,0.4), 0 2px 0 #7d5a0a; }

#btn-generate-qr { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
#btn-generate-qr img { height: 70px; width: auto; }
#clean-all { color: #8B0000; }
.controls-bar { display: flex; flex-direction: column; align-items: center; gap: 144px; padding: 20px 0; }
.row { display: flex; justify-content: center; gap: 20px; width: 100%; }

/* Estandarización de marco y radio */
.camera-viewport, .carrete-item, .rejilla-item, #comparison-view .rejilla-item.expanded {
    border: 8px solid #b8860b;
    border-image: linear-gradient(135deg, #fceabb 0%, #b8860b 50%, #463000 100%) 1;
    border-radius: 20px;
    overflow: hidden;
    background: #000;
    box-sizing: border-box;
}

/* Tamaños porcentuales exactos */
.camera-viewport { width: 80% !important; aspect-ratio: 4/3; margin: 0 auto; }
.carrete-item { width: 16% !important; aspect-ratio: 4/3; margin: 0; }

#webcam { width: 100%; display: block; }

#countdown-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 100; background: rgba(0,0,0,0.3); display: flex; justify-content: center; align-items: center; pointer-events: none; }
#countdown-number { font-size: 7rem; color: #FFD700; font-weight: bold; text-shadow: 2px 2px 4px #000; }
.hidden { display: none !important; }

#thumbnails-container {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    gap: 20px;
    padding: 20px;
    align-items: center;
    flex-grow: 1;
}
#thumbnails-container::-webkit-scrollbar { display: none; }

.nav-btn { height: 100%; width: 60px; background: rgba(0,0,0,0.3); border: none; color: #b8860b; font-size: 3rem; cursor: pointer; z-index: 20; }

/* Base visual (sin tamaño) */
.marco-item { border: 4px solid #b8860b; border-radius: 20px; overflow: hidden; }

.carrete-item img, .carrete-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Tamaño Rejilla (49% estricto) */
.rejilla-item {
    width: 100%;
    aspect-ratio: var(--aspect-x) / var(--aspect-y);
    box-sizing: border-box;
    border: 4px solid #b8860b;
    border-radius: 20px;
    overflow: hidden;
}

/* Tamaño Rejilla - PRIORIDAD ALTA */
/* Especificidad reforzada para la rejilla */
#comparison-view .rejilla-item {
    width: 48% !important;
    aspect-ratio: 4/3 !important;
    margin: 0 !important;
}

#comparison-view .rejilla-item img,
#comparison-view .rejilla-item video {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
}

/* Aplicación a elementos */
.thumbnail-item.carrete-item { @extend .marco-item; }
.thumbnail-item.rejilla-item { @extend .marco-item; }
.thumbnail-item { position: relative; border: 4px solid #b8860b; border-radius: 20px; overflow: hidden; flex-shrink: 0; aspect-ratio: var(--aspect-x) / var(--aspect-y); }
.thumbnail-item img, .thumbnail-item video { width: 100%; height: 100%; object-fit: contain; }
.thumb-actions { position: absolute; bottom: 0; width: 100%; display: flex; justify-content: space-between; background: none; padding: 10px; z-index: 10; }
.thumb-actions button { background: none; border: none; font-size: 2.5rem; cursor: pointer; padding: 5px 15px; }

#debug-log {
    position: fixed;
    top: 10px;
    left: 10px;
    width: 300px;
    max-height: 200px;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 10px;
    z-index: 10000;
    pointer-events: none;
    overflow: hidden;
    padding: 5px;
}

.kiosco-container { display: flex; flex-direction: column; height: 100vh; justify-content: space-between; padding: 20px; }

#comparison-view {
    display: none;
    position: fixed;
    inset: 0;
    background: #000;
    z-index: 9999;
    flex-direction: column;
    padding: 20px;
}
#comparison-view.active { display: flex; }
.close-grid { position: absolute; top: 20px; right: 30px; font-size: 4rem; color: #b8860b; cursor: pointer; z-index: 101; padding: 20px; }

/* Grid 2x2 */
#comparison-view .grid-items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2%;
    width: 100%;
}

#comparison-view .rejilla-item.expanded {
    width: 96% !important;
    height: auto !important;
    aspect-ratio: 4/3 !important;
    position: fixed !important;
    top: 50% !important; left: 50% !important;
    transform: translate(-50%, -50%) !important;
    z-index: 10000 !important;
}

#comparison-view .comparison-footer {
    height: 140px;
    display: flex;
    justify-content: center;
    gap: 20px;
    width: 100%;
    margin-top: 20px;
}

.item-grid img, .item-grid video {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.item-grid img, .item-grid video {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

